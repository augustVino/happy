{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./CMakeLists.txt",
      "arguments": "-DCMAKE_BUILD_TYPE=Release",
      "cppFlags": "-std=c++17 -fno-exceptions -fno-rtti",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "targets": [
    {
      "name": "default"
    }
  ]
}
