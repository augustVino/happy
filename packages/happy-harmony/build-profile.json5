{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.0.2(22)",
        "targetSdkVersion": "6.0.2(22)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    },
    {
      "name": "common",
      "srcPath": "./common"
    },
    {
      "name": "network",
      "srcPath": "./network"
    },
    {
      "name": "auth",
      "srcPath": "./auth"
    },
    {
      "name": "sync",
      "srcPath": "./sync"
    },
    {
      "name": "encryption",
      "srcPath": "./encryption"
    },
    {
      "name": "rpc",
      "srcPath": "./rpc"
    },
    {
      "name": "ui",
      "srcPath": "./ui"
    },
    {
      "name": "services",
      "srcPath": "./services"
    }
  ]
}
